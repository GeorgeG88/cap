# Copy to .env (python manage.py init does this for you and fills SECRET_KEY).
# Never commit .env to Git: it contains secrets.

SECRET_KEY=

# Web server. Keep 127.0.0.1 on your PC. On the Ubuntu VM, set HOST to the
# host-only adapter IP (e.g. 192.168.56.10) so only the lab network can reach it.
HOST=127.0.0.1
PORT=5000
# Used in notification messages to link to the alert page
BASE_URL=http://127.0.0.1:5000
MAX_UPLOAD_MB=50

# --- Telegram -----------------------------------------------------------
# 1. In Telegram, talk to @BotFather -> /newbot -> copy the token.
# 2. Send any message to your new bot.
# 3. Open https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email (SMTP) ---------------------------------------------------------
# Gmail: enable 2-Step Verification, create an App Password, use it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# comma-separated
ALERT_EMAIL_TO=
